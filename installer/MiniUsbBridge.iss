; Mini USB Bridge - Inno Setup 6 script (tested syntax target: Inno Setup 6.3+)
; Build:  iscc installer\MiniUsbBridge.iss     (or run installer\build.ps1)
; SPDX-License-Identifier: MIT
;
; The installer:
;   * installs MiniUsbBridge.exe (native Win32, ~1 MB) for all users
;   * asks how the PC will be used (Server / Client / Both) and creates the
;     matching shortcut + launch parameters
;   * bundles the USB-over-IP backends (usbipd-win MSI + usbip-win2 EXE) so
;     the setup works fully offline - no extra download at install time.
;     CI fetches the official vendor installers (ci/fetch-backends.py/ps1)
;     and the script embeds them. If a backend is already installed the
;     bundled copy is skipped; otherwise it is installed automatically
;     (silent MSI /VERYSILENT EXE) after the app files are copied.
;   * can close the raw USB/IP port 3240 to the network with a firewall rule
;   * installs the optional relay helper and the documentation
;
; Bundling notes:
;   - usbipd-win is GPL-3.0, usbip-win2 is BSD-2-Clause. The vendor binaries
;     are redistributed unmodified; see installer/backends/BUNDLED.md and
;     https://github.com/dorssel/usbipd-win / https://github.com/vadimgrn/usbip-win2
;   - To build offline locally: python3 ci/fetch-backends.py && iscc installer/MiniUsbBridge.iss
;   - The [Files] entries for backends use skipifsourcedoesntexist so a dev
;     build without the large binaries still succeeds (with download links).

#define AppName "Mini USB Bridge"
#define AppVersion "1.0.0"
#define AppPublisher "Mini USB Bridge"
#define AppExe "MiniUsbBridge.exe"
#define AppId "{{B3E1A0F4-5C7D-4E9A-9F2B-6A1D8C3E7F52}"

[Setup]
AppId={#AppId}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
VersionInfoVersion={#AppVersion}
VersionInfoDescription=Mini USB Bridge setup (offline, backends included)
DefaultDirName={autopf}\Mini USB Bridge
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
LicenseFile=..\LICENSE
OutputDir=..\dist
OutputBaseFilename=MiniUsbBridge-{#AppVersion}-setup
SetupIconFile=..\src\ui\app.ico
UninstallDisplayIcon={app}\{#AppExe}
Compression=lzma2/ultra
SolidCompression=yes
WizardStyle=modern
WizardSizePercent=110
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.17763
PrivilegesRequired=admin
CloseApplications=yes
RestartApplications=no
AllowNoIcons=yes
ShowLanguageDialog=no
SetupLogging=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "firewall"; Description: "Block inbound USB/IP port 3240 from the network (recommended)"; GroupDescription: "Security:"
Name: "autostart"; Description: "Start Mini USB Bridge when Windows starts"; GroupDescription: "Startup:"
Name: "installrelay"; Description: "Also install the relay helper (only if you host your own relay)"; GroupDescription: "Optional components:"; Flags: unchecked
Name: "install_usbipd"; Description: "Install usbipd-win (server backend) - included"; GroupDescription: "Backends (bundled, no download needed):"
Name: "install_usbip"; Description: "Install usbip-win2 driver (client backend) - included"; GroupDescription: "Backends (bundled, no download needed):"

[Files]
Source: "..\dist\app\{#AppExe}"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\dist\app\mubb-relay.exe"; DestDir: "{app}"; Flags: ignoreversion; Tasks: installrelay
Source: "..\docs\QUICKSTART.md"; DestDir: "{app}\docs"; Flags: ignoreversion
Source: "..\docs\NETWORKING.md"; DestDir: "{app}\docs"; Flags: ignoreversion
Source: "..\docs\TROUBLESHOOTING.md"; DestDir: "{app}\docs"; Flags: ignoreversion
Source: "..\docs\ARCHITECTURE.md"; DestDir: "{app}\docs"; Flags: ignoreversion
Source: "..\docs\RELAY.md"; DestDir: "{app}\docs"; Flags: ignoreversion
Source: "..\docs\TESTING.md"; DestDir: "{app}\docs"; Flags: ignoreversion
Source: "..\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\README.md"; DestDir: "{app}"; Flags: ignoreversion
; Bundled backend provenance (small text files generated by ci/fetch-backends.py)
Source: "backends\BUNDLED.md"; DestDir: "{app}\docs"; Flags: ignoreversion skipifsourcedoesntexist
Source: "backends\versions.json"; DestDir: "{app}\docs"; Flags: ignoreversion skipifsourcedoesntexist
; Bundled offline backends: CI downloads the official vendor installers into installer/backends/
; The installer embeds them so the setup works fully offline. Dev builds without them still
; succeed (skipifsourcedoesntexist) and show download links instead.
Source: "backends\usbipd-win*.msi"; DestDir: "{tmp}\mub-backends"; Flags: skipifsourcedoesntexist deleteafterinstall
Source: "backends\usbip-win2*.exe"; DestDir: "{tmp}\mub-backends"; Flags: skipifsourcedoesntexist deleteafterinstall
Source: "backends\USBip*.exe"; DestDir: "{tmp}\mub-backends"; Flags: skipifsourcedoesntexist deleteafterinstall

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\{#AppExe}"
Name: "{group}\{#AppName} (Server mode)"; Filename: "{app}\{#AppExe}"; Parameters: "--mode server"
Name: "{group}\{#AppName} (Client mode)"; Filename: "{app}\{#AppExe}"; Parameters: "--mode client"
Name: "{group}\Quick start guide"; Filename: "{app}\docs\QUICKSTART.md"
Name: "{group}\Reaching the other PC (no server needed)"; Filename: "{app}\docs\NETWORKING.md"
Name: "{group}\Troubleshooting"; Filename: "{app}\docs\TROUBLESHOOTING.md"
Name: "{group}\{cm:UninstallProgram,{#AppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Parameters: "{code:GetLaunchParams}"; Tasks: desktopicon

[Run]
Filename: "netsh"; Parameters: "advfirewall firewall delete rule name=""Mini USB Bridge raw USB/IP"""; Flags: runhidden; Tasks: firewall
Filename: "netsh"; Parameters: "advfirewall firewall add rule name=""Mini USB Bridge raw USB/IP"" dir=in action=block protocol=TCP localport=3240 profile=any"; Flags: runhidden; Tasks: firewall
Filename: "reg"; Parameters: "add ""HKCU\Software\Microsoft\Windows\CurrentVersion\Run"" /v MiniUsbBridge /t REG_SZ /d """"{app}\{#AppExe}"""" /f"; Flags: runhidden; Tasks: autostart
Filename: "{app}\docs\QUICKSTART.md"; Description: "Open the quick start guide"; Flags: postinstall shellexec nowait skipifsilent unchecked
Filename: "{app}\{#AppExe}"; Description: "{cm:LaunchProgram,{#AppName}}"; Parameters: "{code:GetLaunchParams}"; Flags: postinstall nowait skipifsilent

[UninstallRun]
Filename: "netsh"; Parameters: "advfirewall firewall delete rule name=""Mini USB Bridge raw USB/IP"""; Flags: runhidden; RunOnceId: "RemoveFirewallRule"
Filename: "reg"; Parameters: "delete ""HKCU\Software\Microsoft\Windows\CurrentVersion\Run"" /v MiniUsbBridge /f"; Flags: runhidden; RunOnceId: "RemoveAutostart"

[Code]
var
  RolePage: TInputOptionWizardPage;
  BackendPage: TWizardPage;
  IntroLabel: TNewStaticText;
  StatusServerLabel: TNewStaticText;
  StatusClientLabel: TNewStaticText;
  ServerDownloadButton: TNewButton;
  ClientDownloadButton: TNewButton;

const
  UrlServerBackend = 'https://github.com/dorssel/usbipd-win/releases/latest';
  UrlClientBackend = 'https://github.com/vadimgrn/usbip-win2/releases/latest';

function FindFirstFileIn(const Dir, Pattern: String): String;
var
  FindRec: TFindRec;
begin
  Result := '';
  if FindFirst(AddBackslash(Dir) + Pattern, FindRec) then
  try
    repeat
      if (FindRec.Attributes and FILE_ATTRIBUTE_DIRECTORY) = 0 then
      begin
        Result := AddBackslash(Dir) + FindRec.Name;
        Exit;
      end;
    until not FindNext(FindRec);
  finally
    FindClose(FindRec);
  end;
end;

function BundledServerInstaller(): String;
begin
  Result := FindFirstFileIn(ExpandConstant('{tmp}\mub-backends'), 'usbipd-win*.msi');
end;

function BundledClientInstaller(): String;
var
  P: String;
begin
  // Try normalized name first (usbip-win2*.exe), then vendor name (USBip*.exe)
  P := FindFirstFileIn(ExpandConstant('{tmp}\mub-backends'), 'usbip-win2*.exe');
  if P = '' then
    P := FindFirstFileIn(ExpandConstant('{tmp}\mub-backends'), 'USBip*.exe');
  if P = '' then
    P := FindFirstFileIn(ExpandConstant('{tmp}\mub-backends'), 'usbip*.exe');
  Result := P;
end;

function FindOnPath(const ExeName: String): String;
var
  PathValue, Rest, Item, Candidate: String;
  P: Integer;
begin
  Result := '';
  PathValue := GetEnv('PATH');
  Rest := PathValue;
  while Rest <> '' do
  begin
    P := Pos(';', Rest);
    if P > 0 then
    begin
      Item := Copy(Rest, 1, P - 1);
      Rest := Copy(Rest, P + 1, Length(Rest));
    end
    else
    begin
      Item := Rest;
      Rest := '';
    end;
    Item := RemoveQuotes(Trim(Item));
    if Item <> '' then
    begin
      Candidate := AddBackslash(Item) + ExeName;
      if FileExists(Candidate) then
      begin
        Result := Candidate;
        Exit;
      end;
    end;
  end;
end;

function UsbipdPath(): String;
var
  P: String;
begin
  P := FindOnPath('usbipd.exe');
  if P = '' then
  begin
    P := ExpandConstant('{autopf}\usbipd-win\usbipd.exe');
    if not FileExists(P) then P := '';
  end;
  Result := P;
end;

function UsbipPath(): String;
var
  P: String;
begin
  P := FindOnPath('usbip.exe');
  if P = '' then
  begin
    P := ExpandConstant('{autopf}\USBip\usbip.exe');
    if not FileExists(P) then P := '';
  end;
  Result := P;
end;

function IsServerRole(): Boolean;
begin
  // RolePage: 0=Server, 1=Client, 2=Both
  Result := (RolePage.SelectedValueIndex = 0) or (RolePage.SelectedValueIndex = 2);
end;

function IsClientRole(): Boolean;
begin
  Result := (RolePage.SelectedValueIndex = 1) or (RolePage.SelectedValueIndex = 2);
end;

procedure RefreshStatus();
var
  ServerInstalled, ClientInstalled: Boolean;
  ServerBundled, ClientBundled: Boolean;
  ServerBundledPath, ClientBundledPath: String;
begin
  ServerInstalled := (UsbipdPath() <> '');
  ClientInstalled := (UsbipPath() <> '') or DirExists(ExpandConstant('{autopf}\USBip'));
  ServerBundledPath := BundledServerInstaller();
  ClientBundledPath := BundledClientInstaller();
  ServerBundled := (ServerBundledPath <> '');
  ClientBundled := (ClientBundledPath <> '');

  // Server line: installed > bundled > missing
  if ServerInstalled then
    StatusServerLabel.Caption := 'Server backend (usbipd-win):  installed (' + ExtractFileName(UsbipdPath()) + ')'
  else if ServerBundled then
    StatusServerLabel.Caption := 'Server backend (usbipd-win):  bundled - will be installed automatically'
  else
    StatusServerLabel.Caption := 'Server backend (usbipd-win):  not found (no bundled installer)';

  // Client line
  if ClientInstalled then
    StatusClientLabel.Caption := 'Client backend (usbip-win2 driver):  installed'
  else if ClientBundled then
    StatusClientLabel.Caption := 'Client backend (usbip-win2 driver):  bundled - will be installed automatically'
  else
    StatusClientLabel.Caption := 'Client backend (usbip-win2 driver):  not found (no bundled installer)';

  // Button captions: if bundled, offer to install it; otherwise offer download
  if ServerBundled then
  begin
    if ServerInstalled then
      ServerDownloadButton.Caption := 'usbipd-win already installed'
    else
      ServerDownloadButton.Caption := 'Install bundled usbipd-win';
    ServerDownloadButton.Enabled := not ServerInstalled;
  end
  else
  begin
    ServerDownloadButton.Caption := 'Download usbipd-win (server)';
    ServerDownloadButton.Enabled := True;
  end;

  if ClientBundled then
  begin
    if ClientInstalled then
      ClientDownloadButton.Caption := 'usbip-win2 already installed'
    else
      ClientDownloadButton.Caption := 'Install bundled usbip-win2';
    ClientDownloadButton.Enabled := not ClientInstalled;
  end
  else
  begin
    ClientDownloadButton.Caption := 'Download usbip-win2 (client)';
    ClientDownloadButton.Enabled := True;
  end;
end;

procedure OpenUrl(const Url: String);
var
  ErrorCode: Integer;
begin
  ShellExec('open', Url, '', '', SW_SHOWNORMAL, ewNoWait, ErrorCode);
end;

function InstallMsiSilently(const MsiPath: String): Boolean;
var
  Params: String;
  ResultCode: Integer;
begin
  Result := False;
  // Run via msiexec /i "path" /qn /norestart - silent, no reboot
  Params := '/i "' + MsiPath + '" /qn /norestart';
  Log('Installing MSI silently: msiexec ' + Params);
  if Exec('msiexec.exe', Params, '', SW_SHOW, ewWaitUntilTerminated, ResultCode) then
  begin
    Log('msiexec exit code: ' + IntToStr(ResultCode));
    if ResultCode = 0 then Result := True
    else if ResultCode = 1641 then Result := True // success, reboot initiated (we suppressed, but handle)
    else if ResultCode = 3010 then Result := True // success, reboot required
    else
    begin
      Log('msiexec failed, trying non-silent fallback');
      // Fallback: try opening MSI directly (shows UI)
      if ShellExec('open', MsiPath, '', '', SW_SHOWNORMAL, ewWaitUntilTerminated, ResultCode) then
        Log('fallback ShellExec exit code: ' + IntToStr(ResultCode));
    end;
  end
  else
    Log('Exec msiexec failed');
end;

function InstallExeSilently(const ExePath: String): Boolean;
var
  Params: String;
  ResultCode: Integer;
begin
  Result := False;
  // usbip-win2 is an Inno Setup installer - /VERYSILENT is recommended
  // Try VERYSILENT first, then SILENT, then normal
  Params := '/VERYSILENT /SUPPRESSMSGBOXES /NORESTART';
  Log('Installing EXE silently: ' + ExePath + ' ' + Params);
  if Exec(ExePath, Params, '', SW_SHOW, ewWaitUntilTerminated, ResultCode) then
  begin
    Log('exe installer exit code: ' + IntToStr(ResultCode));
    if ResultCode = 0 then Result := True
    else if ResultCode = 1 then Result := True // some Inno installers return 1 on success with reboot needed
    else
    begin
      // Try /SILENT as fallback
      Params := '/SILENT /SUPPRESSMSGBOXES /NORESTART';
      Log('Trying fallback: ' + ExePath + ' ' + Params);
      if Exec(ExePath, Params, '', SW_SHOW, ewWaitUntilTerminated, ResultCode) then
      begin
        Log('fallback exit code: ' + IntToStr(ResultCode));
        Result := (ResultCode = 0) or (ResultCode = 1);
      end;
    end;
  end;
  if not Result then
  begin
    Log('Silent install failed, trying interactive');
    if ShellExec('open', ExePath, '', '', SW_SHOWNORMAL, ewWaitUntilTerminated, ResultCode) then
    begin
      Log('interactive exit code: ' + IntToStr(ResultCode));
      Result := (ResultCode = 0);
    end;
  end;
end;

procedure ServerDownloadClick(Sender: TObject);
var
  Path: String;
  Code: Integer;
begin
  Path := BundledServerInstaller();
  if Path <> '' then
  begin
    if UsbipdPath() <> '' then
    begin
      MsgBox('usbipd-win is already installed at:' + #13#10 + UsbipdPath(), mbInformation, MB_OK);
      Exit;
    end;
    if MsgBox('Install the bundled usbipd-win now? (required for Server mode)', mbConfirmation, MB_YESNO) = IDYES then
    begin
      if InstallMsiSilently(Path) then
      begin
        MsgBox('usbipd-win was installed. You may need to restart the service.', mbInformation, MB_OK);
        RefreshStatus();
      end
      else
        MsgBox('The usbipd-win installer did not complete successfully. Check the log at %TEMP%\MiniUsbBridge setup log.', mbInformation, MB_OK);
    end;
  end
  else
    OpenUrl(UrlServerBackend);
end;

procedure ClientDownloadClick(Sender: TObject);
var
  Path: String;
begin
  Path := BundledClientInstaller();
  if Path <> '' then
  begin
    if (UsbipPath() <> '') or DirExists(ExpandConstant('{autopf}\USBip')) then
    begin
      MsgBox('usbip-win2 is already installed.', mbInformation, MB_OK);
      Exit;
    end;
    if MsgBox('Install the bundled usbip-win2 now? (required for Client mode)' + #13#10 +
              'Close other work first: USB 3.0 hubs are restarted during that installation.', mbConfirmation, MB_YESNO) = IDYES then
    begin
      if InstallExeSilently(Path) then
      begin
        MsgBox('usbip-win2 was installed. A reboot may be required for the driver.', mbInformation, MB_OK);
        RefreshStatus();
      end
      else
        MsgBox('The usbip-win2 installer did not complete successfully.', mbInformation, MB_OK);
    end;
  end
  else
    OpenUrl(UrlClientBackend);
end;

function GetLaunchParams(Param: String): String;
begin
  if RolePage.SelectedValueIndex = 0 then
    Result := '--mode server'
  else if RolePage.SelectedValueIndex = 1 then
    Result := '--mode client'
  else
    Result := '';
end;

procedure InitializeWizard();
begin
  RolePage := CreateInputOptionPage(wpSelectTasks,
    'How will this computer be used?',
    'Mini USB Bridge can act as a server, as a client, or both.',
    'This only decides the shortcut and the mode the app opens with. Nothing is shared and no client is ' +
    'connected automatically: you approve every client, and you pick which devices to share.',
    True, False);
  RolePage.Add('Server - USB devices are plugged into this PC and shared with a remote client');
  RolePage.Add('Client - this PC uses USB devices that are plugged into a remote server');
  RolePage.Add('Both - I will choose each time I start the app');
  RolePage.SelectedValueIndex := 2;

  BackendPage := CreateCustomPage(RolePage.ID, 'USB-over-IP backends',
    'The actual USB redirection is done by two proven open-source programs. Both are included in this installer.');

  IntroLabel := TNewStaticText.Create(BackendPage);
  IntroLabel.Parent := BackendPage.Surface;
  IntroLabel.Left := 0;
  IntroLabel.Top := 0;
  IntroLabel.Width := BackendPage.SurfaceWidth;
  IntroLabel.Height := 96;
  IntroLabel.AutoSize := False;
  IntroLabel.WordWrap := True;
  IntroLabel.Caption :=
    'This installer is fully offline: the required backends are already inside.' + #13#10 +
    'usbipd-win  (server side) exports the USB device.' + #13#10 +
    'usbip-win2 (client side) installs the virtual USB host controller driver, so the remote device ' +
    'really appears in Device Manager.' + #13#10#13#10 +
    'They will be installed automatically for your selected role. The client driver install may restart USB 3.0 hubs and ' +
    'can require a reboot; close file transfers and calls before you continue.';

  StatusServerLabel := TNewStaticText.Create(BackendPage);
  StatusServerLabel.Parent := BackendPage.Surface;
  StatusServerLabel.Left := 0;
  StatusServerLabel.Top := 106;
  StatusServerLabel.Width := BackendPage.SurfaceWidth;
  StatusServerLabel.Font.Style := [fsBold];
  StatusServerLabel.Caption := '';

  StatusClientLabel := TNewStaticText.Create(BackendPage);
  StatusClientLabel.Parent := BackendPage.Surface;
  StatusClientLabel.Left := 0;
  StatusClientLabel.Top := 128;
  StatusClientLabel.Width := BackendPage.SurfaceWidth;
  StatusClientLabel.Font.Style := [fsBold];
  StatusClientLabel.Caption := '';

  ServerDownloadButton := TNewButton.Create(BackendPage);
  ServerDownloadButton.Parent := BackendPage.Surface;
  ServerDownloadButton.Left := 0;
  ServerDownloadButton.Top := 158;
  ServerDownloadButton.Width := 230;
  ServerDownloadButton.Height := 30;
  ServerDownloadButton.Caption := 'Download usbipd-win (server)';
  ServerDownloadButton.OnClick := @ServerDownloadClick;

  ClientDownloadButton := TNewButton.Create(BackendPage);
  ClientDownloadButton.Parent := BackendPage.Surface;
  ClientDownloadButton.Left := 238;
  ClientDownloadButton.Top := 158;
  ClientDownloadButton.Width := 230;
  ClientDownloadButton.Height := 30;
  ClientDownloadButton.Caption := 'Download usbip-win2 (client)';
  ClientDownloadButton.OnClick := @ClientDownloadClick;

  RefreshStatus();
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if CurPageID = BackendPage.ID then
    RefreshStatus();
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  Msg: String;
  NeedServer, NeedClient: Boolean;
  ServerOk, ClientOk: Boolean;
begin
  Result := True;
  if CurPageID = BackendPage.ID then
  begin
    NeedServer := IsServerRole();
    NeedClient := IsClientRole();
    ServerOk := (UsbipdPath() <> '') or (BundledServerInstaller() <> '');
    ClientOk := (UsbipPath() <> '') or DirExists(ExpandConstant('{autopf}\USBip')) or
                (BundledClientInstaller() <> '');

    // If the needed backends are either installed or bundled, no warning
    if NeedServer and not ServerOk then
    begin
      Msg := 'The server backend (usbipd-win) was not found and is not bundled in this installer.' + #13#10#13#10 +
             'Server mode will not be able to share USB devices until it is installed.' + #13#10#13#10 +
             'This setup was built without the bundled backend (dev build). Use the official' + #13#10 +
             'release from GitHub Releases for a fully offline installer.' + #13#10#13#10 +
             'Continue anyway?';
      if MsgBox(Msg, mbConfirmation, MB_YESNO) = IDNO then begin Result := False; Exit; end;
    end;
    if NeedClient and not ClientOk then
    begin
      Msg := 'The client backend (usbip-win2) was not found and is not bundled in this installer.' + #13#10#13#10 +
             'Client mode will not be able to attach USB devices until it is installed.' + #13#10#13#10 +
             'Continue anyway?';
      if MsgBox(Msg, mbConfirmation, MB_YESNO) = IDNO then begin Result := False; Exit; end;
    end;
    // Both roles but neither backend at all (should not happen with bundled installer)
    if (not NeedServer and not NeedClient) then
    begin
      // "Both" needs at least one backend technically, but we allow it
    end;
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  ServerMsi, ClientExe: String;
  NeedServer, NeedClient: Boolean;
  ServerInstalled, ClientInstalled: Boolean;
  DidServer, DidClient: Boolean;
  Msg: String;
begin
  if CurStep <> ssPostInstall then Exit;

  NeedServer := IsServerRole();
  NeedClient := IsClientRole();
  ServerMsi := BundledServerInstaller();
  ClientExe := BundledClientInstaller();
  ServerInstalled := (UsbipdPath() <> '');
  ClientInstalled := (UsbipPath() <> '') or DirExists(ExpandConstant('{autopf}\USBip'));
  DidServer := False;
  DidClient := False;

  // Decide whether we should auto-install: only if needed for the selected role and not already installed
  // Single consolidated prompt if at least one install is needed
  if ((NeedServer and not ServerInstalled and (ServerMsi <> '') and WizardIsTaskSelected('install_usbipd')) or
      (NeedClient and not ClientInstalled and (ClientExe <> '') and WizardIsTaskSelected('install_usbip'))) then
  begin
    Msg := 'This setup includes the USB/IP backends.' + #13#10#13#10;
    if NeedServer and not ServerInstalled and (ServerMsi <> '') and WizardIsTaskSelected('install_usbipd') then
      Msg := Msg + '- usbipd-win (server) will be installed silently.' + #13#10;
    if NeedClient and not ClientInstalled and (ClientExe <> '') and WizardIsTaskSelected('install_usbip') then
      Msg := Msg + '- usbip-win2 driver (client) will be installed. USB 3.0 hubs will restart and a reboot may be needed.' + #13#10;
    Msg := Msg + #13#10 + 'Install the required backend(s) now? (Recommended: Yes)';

    if MsgBox(Msg, mbConfirmation, MB_YESNO) = IDNO then
    begin
      Log('User declined automatic backend installation');
      Exit;
    end;
  end;

  // Install server backend if needed (respects Tasks page checkbox if present)
  if NeedServer and not ServerInstalled and (ServerMsi <> '') and WizardIsTaskSelected('install_usbipd') then
  begin
    Log('Auto-installing server backend: ' + ServerMsi);
    if InstallMsiSilently(ServerMsi) then
    begin
      Log('Server backend installed successfully');
      DidServer := True;
    end
    else
    begin
      Msg := 'The usbipd-win installer did not complete successfully.' + #13#10 +
             'You can run it manually from: ' + ServerMsi + #13#10 +
             'Or download it from: ' + UrlServerBackend;
      MsgBox(Msg, mbInformation, MB_OK);
    end;
  end
  else if NeedServer and ServerInstalled then
    Log('Server backend already installed, skipping bundled MSI')
  else if NeedServer and (ServerMsi = '') then
    Log('Server backend needed but no bundled MSI found');

  // Install client backend if needed (respects Tasks page checkbox if present)
  if NeedClient and not ClientInstalled and (ClientExe <> '') and WizardIsTaskSelected('install_usbip') then
  begin
    Log('Auto-installing client backend: ' + ClientExe);
    if InstallExeSilently(ClientExe) then
    begin
      Log('Client backend installed successfully');
      DidClient := True;
    end
    else
    begin
      Msg := 'The usbip-win2 installer did not complete successfully.' + #13#10 +
             'You can run it manually from: ' + ClientExe + #13#10 +
             'Or download it from: ' + UrlClientBackend;
      MsgBox(Msg, mbInformation, MB_OK);
    end;
  end
  else if NeedClient and ClientInstalled then
    Log('Client backend already installed, skipping bundled EXE')
  else if NeedClient and (ClientExe = '') then
    Log('Client backend needed but no bundled EXE found');

  if DidServer or DidClient then
  begin
    Msg := 'Backend installation finished.';
    if DidServer then Msg := Msg + #13#10 + '- usbipd-win installed';
    if DidClient then Msg := Msg + #13#10 + '- usbip-win2 installed (a reboot may be needed)';
    MsgBox(Msg, mbInformation, MB_OK);
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
  begin
    MsgBox('Mini USB Bridge was removed.' + #13#10#13#10 +
           'usbipd-win and usbip-win2 were NOT removed: they are separate products. ' + #13#10 +
           'Uninstall them from "Apps & features" if you no longer need them.', mbInformation, MB_OK);
  end;
end;
